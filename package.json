{
  "name": "kollection-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cache:photos": "node tools/cache-photos.mjs",
    "download:x-hd": "node tools/download-x-hd-from-manifest.mjs",
    "serve": "python3 -m http.server 4173",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components content",
    "verify:prototype": "node tools/check-prototype.cjs && node tools/check-touch.cjs",
    "images:build": "node scripts/generate-photo-derivatives.mjs",
    "verify:phase2": "node tools/check-phase-2.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.0",
    "next": "16.4.2",
    "photoswipe": "^5.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
